{
  "name": "weekwise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node-pg-migrate -f migrate-config.js -m migrations -j sql",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate up && npm run db:seed",
    "dev:api": "tsx server/src/server.ts",
    "dev:web": "npm run dev --workspace=web",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
