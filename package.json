{
  "name": "weekwise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node-pg-migrate -f migrate-config.js -m migrations -j sql"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
